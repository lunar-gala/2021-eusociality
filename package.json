{
  "name": "2021-eusociality",
  "version": "2.0.0",
  "description": "Theme site for Lunar Gala 2021: Eusociality",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d build",
    "lint": "eslint --ext .js,.jsx src/",
    "lint-fix": "eslint --fix --ext .js,.jsx src/",
    "format": "prettier --write \"src/**/*.{js,jsx,scss,json}\" \"*.{js,json,html}\"",
    "format-check": "prettier --check \"src/**/*.{js,jsx,scss,json}\" \"*.{js,json,html}\"",
    "test": "vitest run",
    "test-watch": "vitest",
    "e2e": "node scripts/e2e-check.mjs"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunar-gala/2021-eusociality.git"
  },
  "author": "lunargala",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lunar-gala/2021-eusociality/issues"
  },
  "homepage": "https://github.com/lunar-gala/2021-eusociality#readme",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/dat.gui": "^0.7.13",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "gh-pages": "^6.2.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "vite": "^5.4.11",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "@tweenjs/tween.js": "^21.1.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-player": "^2.16.0",
    "react-router-dom": "^5.3.4",
    "react-transition-group": "^4.4.5",
    "three": "0.122.0"
  }
}
